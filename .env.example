MIST_API_TOKEN=your_api_token_here
MIST_ORG_ID=your_org_id_here
MIST_BASE_URL=https://api.mist.com/api/v1
POLLING_INTERVAL_SECONDS=300
TIMEZONE=Asia/Tokyo
API_URL=http://localhost:8008
CORS_ORIGINS=http://localhost:3007
# Set a strong random secret to protect the credentials API endpoint.
# If empty, the endpoint is open (acceptable for local-only deployments).
# Example: openssl rand -hex 32
SETTINGS_SECRET=
